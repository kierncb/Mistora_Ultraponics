rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/thresholds {
      allow read, write: if true;
    }

    // Live device state remains writable by the dashboard/device.
    match /sensor_readings/latest {
      allow read, write: if true;
    }

    // Raw sensor history is the source of truth for rollup generation.
    match /sensor_readings/logs/history/{readingId} {
      allow read, write: if true;
    }

    // Summary rollups are read-only from the client; Cloud Functions writes them.
    match /sensor_readings/rollups/{window}/{bucketId} {
      allow read: if true;
      allow write: if false;
    }

    // Allow dashboard to record and read operational activity logs.
    match /activity_logs/{docId} {
      allow read, write: if true;
    }

    // Fallback: deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
